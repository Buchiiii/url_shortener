    {
      "id": "QHtM5UM0369xo4GrGnVUr",
      "type": "text",
      "x": 259.6354599451119,
      "y": -172.04485823819607,
      "width": 565.1396484375,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
