    {
      "id": "byU2EqhoNY56TB8heh8u2",
      "type": "text",
      "x": -664.0266371512937,
      "y": -140.69998168945312,
      "width": 752.1601213715801,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1821947275,
      "version": 681,
      "versionNonce": 1191234731,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784749060438,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- Users should be able to input a long url and get the shortened url back\n- Users should be able to specify the alias or they can leave it\nblank[optional]\n- Users should be able to choose when they want the link to expire.\n[optional]\n- Users should be able to be redirected to their initial link when they type in\nthe short code\n\n\nNon Functional Requirements",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- Users should be able to input a long url and get the shortened url back\n- Users should be able to specify the alias or they can leave it blank[optional]\n- Users should be able to choose when they want the link to expire.[optional]\n- Users should be able to be redirected to their initial link when they type in the short code\n\n\nNon Functional Requirements",
      "autoResize": false,
      "lineHeight": 1.25
    },
