    {
      "id": "JaK6-RwjiLa7xuCyczI7X",
      "type": "text",
      "x": 1416.0845427017282,
      "y": -182.4169041862787,
      "width": 677.2994995117188,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1088097675,
      "version": 466,
      "versionNonce": 1163567755,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784749020336,
      "link": null,
      "locked": false,
      "text": "STEP THREE\n\nAPI and Interface Design\n\n- Create Link\n    - api : /api/v1/links\n    - method : POST\n    - request : {link : string, alias: string, expireTime: number}\n    - response: {data: [{short_code: string, expirationTime: string}], \n      message: string, statuscode: number}\n\n- Redirect Link\n    - api: /:shortcode\n    - method: GET\n    - reponse: redirect to long url",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STEP THREE\n\nAPI and Interface Design\n\n- Create Link\n    - api : /api/v1/links\n    - method : POST\n    - request : {link : string, alias: string, expireTime: number}\n    - response: {data: [{short_code: string, expirationTime: string}], \n      message: string, statuscode: number}\n\n- Redirect Link\n    - api: /:shortcode\n    - method: GET\n    - reponse: redirect to long url",
      "autoResize": true,
      "lineHeight": 1.25
    },
